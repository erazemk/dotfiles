{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "devrev": {
      "model": "amazon-bedrock/gpt-5.6-luna"
    },
    "howto": {
      "model": "amazon-bedrock/gpt-5.6-luna"
    },
    "oracle": {
      "model": "amazon-bedrock/gpt-5.6-sol"
    },
    "plan": {
      "model": "amazon-bedrock/gpt-5.6-terra"
    }
  },
  "autoupdate": true,
  "enabled_providers": [
    "amazon-bedrock",
    "openrouter"
  ],
  "experimental": {
    "disable_paste_summary": true
  },
  "formatter": true,
  "instructions": [
    "~/.config/dotfiles/common/opencode/AGENTS.md"
  ],
  "mcp": {
    "devrev": {
      "headers": {
        "Authorization": "Bearer {env:DEVREV_API_KEY}"
      },
      "type": "remote",
      "url": "https://api.devrev.ai/mcp/v1"
    },
    "slack": {
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "redirectUri": "http://localhost:3118/callback"
      },
      "type": "remote",
      "url": "https://mcp.slack.com/mcp"
    }
  },
  "model": "amazon-bedrock/gpt-5.6-luna",
  "permission": {
    "devrev_*": "deny",
    "external_directory": {
      "~/.cache/sidekick/cache/go/**": "allow",
      "~/.config/dotfiles/**/opencode/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.local/share/go/**": "allow",
      "~/DevRev/**": "allow",
      "~/Library/Application Support/rtk/tee/**": "allow"
    },
    "slack_*": "deny",
    "slack_slack_read_channel": "allow",
    "slack_slack_read_thread": "allow",
    "slack_slack_search_channels": "allow",
    "slack_slack_search_public_and_private": "allow"
  },
  "provider": {
    "amazon-bedrock": {
      "models": {
        "gpt-5.6-luna": {
          "id": "openai.gpt-5.6-luna",
          "limit": {
            "context": 272000,
            "input": 272000,
            "output": 128000
          },
          "name": "GPT 5.6 Luna"
        },
        "gpt-5.6-sol": {
          "id": "openai.gpt-5.6-sol",
          "limit": {
            "context": 272000,
            "input": 272000,
            "output": 128000
          },
          "name": "GPT 5.6 Sol"
        },
        "gpt-5.6-terra": {
          "id": "openai.gpt-5.6-terra",
          "limit": {
            "context": 272000,
            "input": 272000,
            "output": 128000
          },
          "name": "GPT 5.6 Terra"
        }
      },
      "options": {
        "profile": "default",
        "region": "us-east-1"
      },
      "whitelist": [
        "gpt-5.6-luna",
        "gpt-5.6-sol",
        "gpt-5.6-terra"
      ]
    },
    "openrouter": {
      "models": {
        "gpt-5.6-luna": {
          "id": "openai/gpt-5.6-luna",
          "limit": {
            "context": 272000,
            "input": 272000,
            "output": 128000
          },
          "name": "GPT 5.6 Luna"
        },
        "gpt-5.6-sol": {
          "id": "openai/gpt-5.6-sol",
          "limit": {
            "context": 272000,
            "input": 272000,
            "output": 128000
          },
          "name": "GPT 5.6 Sol"
        },
        "gpt-5.6-terra": {
          "id": "openai/gpt-5.6-terra",
          "limit": {
            "context": 272000,
            "input": 272000,
            "output": 128000
          },
          "name": "GPT 5.6 Terra"
        }
      },
      "name": "Arcus",
      "npm": "@ai-sdk/openai",
      "options": {
        "apiKey": "{env:ARCUS_API_KEY}",
        "baseURL": "https://ai-gateway.dev.devrev-eng.ai/v1"
      },
      "whitelist": [
        "gpt-5.6-luna",
        "gpt-5.6-sol",
        "gpt-5.6-terra"
      ]
    }
  },
  "references": {
    "repos": {
      "description": "Use when needing to view code in other cloned DevRev repositories (~/DevRev directory)",
      "hidden": true,
      "path": "~/DevRev"
    }
  },
  "small_model": "amazon-bedrock/gpt-5.6-luna",
  "watcher": {
    "ignore": [
      "_build/**"
    ]
  }
}
