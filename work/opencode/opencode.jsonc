      },
      "name": "Arcus",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:ARCUS_API_KEY}",
        "baseURL": "https://ai-gateway.dev.devrev-eng.ai/v1"
      }
    }
  },
  "references": {
    "repos": {
      "description": "Use when needing to view code in other cloned DevRev repositories (~/DevRev directory)",
      "hidden": true,
      "path": "~/DevRev"
    }
  },
  "small_model": "litellm/gpt-5.6-luna",
  "watcher": {
    "ignore": [
      "_build/**"
    ]
  }
}
