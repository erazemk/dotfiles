{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "disable_paste_summary": true
  },
  "formatter": true,
  "mcp": {
    "circleci": {
      "command": [
        "npx",
        "-y",
        "@circleci/mcp-server-circleci@latest"
      ],
      "enabled": false,
      "environment": {
        "CIRCLECI_TOKEN": "{env:CIRCLECI_TOKEN}"
      },
      "type": "local"
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/v1/mcp"
    },
    "devrev": {
      "headers": {
        "Authorization": "Bearer {env:DEVREV_API_KEY}"
      },
      "type": "remote",
      "url": "https://api.devrev.ai/mcp/v1"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "granola": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.granola.ai/mcp"
    },
    "slack": {
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "redirectUri": "http://localhost:3118/callback"
      },
      "type": "remote",
      "url": "https://mcp.slack.com/mcp"
    }
  },
  "model": "litellm/gpt-5.6-terra[1]",
  "permission": {
    "datadog_*": "deny",
    "datadog_aggregate_events": "allow",
    "datadog_aggregate_spans": "allow",
    "datadog_analyze_datadog_logs": "allow",
    "datadog_get_datadog_dashboard": "allow",
    "datadog_get_datadog_trace": "allow",
    "datadog_list_datadog_skills": "allow",
    "datadog_load_datadog_skill": "allow",
    "datadog_search_datadog_dashboards": "allow",
    "datadog_search_datadog_events": "allow",
    "datadog_search_datadog_logs": "allow",
    "datadog_search_datadog_metrics": "allow",
    "datadog_search_datadog_services": "allow",
    "datadog_search_datadog_spans": "allow",
    "devrev_*": "deny", // (for now only devrev agent has access)
    "external_directory": {
      "~/.cache/sidekick/cache/go/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.local/share/go/**": "allow",
      "~/DevRev/**": "allow"
    },
    "slack_*": "deny",
    "slack_slack_list_channel_members": "allow",
    "slack_slack_read_channel": "allow",
    "slack_slack_read_file": "allow",
    "slack_slack_read_thread": "allow",
    "slack_slack_read_user_profile": "allow",
    "slack_slack_search_channels": "allow",
    "slack_slack_search_public": "allow",
    "slack_slack_search_public_and_private": "allow",
    "slack_slack_search_users": "allow",
    "slack_slack_send_message_draft": "allow"
  },
  "plugin": [
    "opencode-plugin-litellm@latest"
  ],
  "provider": {
    "litellm": {
      "name": "Arcus",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:ARCUS_API_KEY}",
        "baseURL": "https://ai-gateway.dev.devrev-eng.ai/v1"
      }
    }
  },
  "enabled_providers": [
    "litellm",
  ],
  "small_model": "litellm/gpt-5.6-luna[1m]",
  "watcher": {
    "ignore": [
      "_build/**"
    ]
  }
}
