{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "oracle": {
      "model": "amazon-bedrock/openai.gpt-5.6-sol",
      "permission": {
        "external_directory": {
          "~/DevRev/**": "allow"
        }
      }
    }
  },
  "autoupdate": true,
  "experimental": {
    "disable_paste_summary": true
  },
  "formatter": true,
  "instructions": [
    "~/.config/dotfiles/common/opencode/AGENTS.md"
  ],
  "mcp": {
    "devrev": {
      "headers": {
        "Authorization": "Bearer {env:DEVREV_API_KEY}"
      },
      "type": "remote",
      "url": "https://api.devrev.ai/mcp/v1"
    },
    "gopls": {
      "command": [
        "gopls",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "slack": {
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "redirectUri": "http://localhost:3118/callback"
      },
      "type": "remote",
      "url": "https://mcp.slack.com/mcp"
    }
  },
  "model": "amazon-bedrock/openai.gpt-5.6-luna",
  "permission": {
    "devrev_*": "deny",
    "external_directory": {
      "~/.cache/sidekick/**": "allow",
      "~/.config/dotfiles/**/opencode/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.local/share/go/**": "allow",
      "~/DevRev/**": "allow",
      "~/Library/Application Support/rtk/tee/**": "allow"
    },
    "glob *": "allow",
    "grep *": "allow",
    "slack_*": "deny",
    "slack_slack_read_channel": "allow",
    "slack_slack_read_thread": "allow",
    "slack_slack_search_channels": "allow",
    "slack_slack_search_public_and_private": "allow"
  },
  "provider": {
    "amazon-bedrock": {
      "options": {
        "profile": "default",
        "region": "us-east-1"
      }
    }
  },
  "references": {
    "repos": {
      "description": "Use when needing to view code in other cloned DevRev repositories (~/DevRev directory)",
      "hidden": true,
      "path": "~/DevRev"
    }
  },
  "small_model": "amazon-bedrock/openai.gpt-5.6-luna",
  "watcher": {
    "ignore": [
      "_build/**"
    ]
  }
}
