{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "compaction": {
      "model": "litellm/gpt-5.6-sol"
    },
    "explore": {
      "model": "litellm/gpt-5.6-luna"
    },
    "general": {
      "model": "litellm/gpt-5.6-luna"
    },
    "oracle": {
      "model": "litellm/gpt-5.6-sol",
      "options": {
        "reasoningEffort": "xhigh"
      },
      "permission": {
        "external_directory": {
          "~/.cache/sidekick/**": "allow",
          "~/.config/dotfiles/**": "allow",
          "~/.config/opencode/**": "allow",
          "~/.local/share/go/**": "allow",
          "~/DevRev/**": "allow",
          "~/go/**": "allow",
          "~/Library/Application Support/rtk/tee/**": "allow"
        }
      }
    }
  },
  "autoupdate": true,
  "experimental": {
    "disable_paste_summary": true
  },
  "formatter": true,
  "instructions": [
    "~/.config/dotfiles/common/opencode/AGENTS.md"
  ],
  "mcp": {
    "circleci": {
      "command": [
        "circleci",
        "mcp",
        "start"
      ],
      "enabled": false,
      "type": "local"
    },
    "devrev": {
      "headers": {
        "Authorization": "Bearer {env:DEVREV_API_KEY}"
      },
      "type": "remote",
      "url": "https://api.devrev.ai/mcp/v1"
    },
    "gopls": {
      "command": [
        "gopls",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "granola": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.granola.ai/mcp"
    },
    "slack": {
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "redirectUri": "http://localhost:3118/callback"
      },
      "type": "remote",
      "url": "https://mcp.slack.com/mcp"
    }
  },
  "model": "litellm/gpt-5.6-sol",
  "permission": {
    "circleci_*": "deny",
    "circleci_api": "allow",
    "circleci_auth_me": "allow",
    "circleci_circleci_workflow_get": "allow",
    "circleci_job_output_get": "allow",
    "circleci_job_output_list": "allow",
    "circleci_run_get": "allow",
    "devrev_*": "deny",
    "external_directory": {
      "~/.cache/sidekick/**": "allow",
      "~/.config/dotfiles/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.local/share/go/**": "allow",
      "~/DevRev/**": "allow",
      "~/go/**": "allow",
      "~/Library/Application Support/rtk/tee/**": "allow"
    },
    "glob *": "allow",
    "grep *": "allow",
    "slack_*": "deny",
    "slack_slack_read_channel": "allow",
    "slack_slack_read_thread": "allow",
    "slack_slack_search_channels": "allow",
    "slack_slack_search_public_and_private": "allow"
  },
  "provider": {
    "amazon-bedrock": {
      "models": {
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "xhigh"
          },
          "reasoning": true
        },
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "medium"
          },
          "reasoning": true
        }
      },
      "options": {
        "profile": "default",
        "region": "us-east-1"
      }
    },
    "litellm": {
      "models": {
        "claude-fable-5-1": {
          "cost": {
            "cache_read": 0.25,
            "cache_write": 12.5,
            "input": 10,
            "output": 50
          },
          "limit": {
            "context": 1000000,
            "input": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "Claude Fable 5.1",
          "options": {
            "reasoningEffort": "medium"
          },
          "reasoning": true,
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "none": {
              "reasoningEffort": "none"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "gemini-3.8-flash": {
