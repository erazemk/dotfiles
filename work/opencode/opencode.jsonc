{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "devrev": {
      "model": "openrouter/openai/gpt-5.6-luna"
    },
    "howto": {
      "model": "openrouter/openai/gpt-5.6-luna"
    },
    "oracle": {
      "model": "openrouter/openai/gpt-5.6-sol"
    },
    "slack": {
      "description": "Interacts with Slack using read-only tools. Use when needing to search through slack channels, threads etc. Provide it any relevant info it could use to help in the searching, including any user names, channel names, Slack links, search terms, dates, etc.",
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5.6-luna",
      "permission": {
        "*": "deny",
        "question": "allow",
        "slack_slack_read_channel": "allow",
        "slack_slack_read_thread": "allow",
        "slack_slack_search_channels": "allow",
        "slack_slack_search_public_and_private": "allow"
      },
      "prompt": "Search through Slack to find information that will satisfy the request."
    }
  },
  "autoupdate": true,
  "experimental": {
    "disable_paste_summary": true
  },
  "formatter": true,
  "instructions": [
    "~/.config/dotfiles/common/opencode/AGENTS.md"
  ],
  "mcp": {
    "devrev": {
      "headers": {
        "Authorization": "Bearer {env:DEVREV_API_KEY}"
      },
      "type": "remote",
      "url": "https://api.devrev.ai/mcp/v1"
    },
    "slack": {
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "redirectUri": "http://localhost:3118/callback"
      },
      "type": "remote",
      "url": "https://mcp.slack.com/mcp"
    }
  },
  "model": "openrouter/openai/gpt-5.6-luna",
  "permission": {
    "devrev_*": "deny",
    "external_directory": {
      "~/.cache/sidekick/cache/go/**": "allow",
      "~/.config/dotfiles/**/opencode/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.local/share/go/**": "allow",
      "~/DevRev/**": "allow"
    },
    "slack_*": "deny"
  },
  "provider": {
    "openrouter": {
      "models": {
        "openai/gpt-5.6-luna": {
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "name": "GPT 5.6 Luna"
        },
        "openai/gpt-5.6-sol": {
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "name": "GPT 5.6 Sol"
        },
        "openai/gpt-5.6-terra": {
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "name": "GPT 5.6 Terra"
        }
      },
      "name": "Arcus",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:ARCUS_API_KEY}",
        "baseURL": "https://ai-gateway.dev.devrev-eng.ai/v1"
      }
    }
  },
  "small_model": "openrouter/openai/gpt-5.6-luna",
  "watcher": {
    "ignore": [
      "_build/**"
    ]
  }
}
